    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Shown in the system alert the first time the app writes to Photos.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphiqo sichert deine fertigen Videos und Fotos in deiner Fotomediathek. Nichts wird irgendwohin hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphiqo saves your finished videos and photos to your library. Nothing is uploaded anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphiqo guarda tus videos y fotos terminados en tu fototeca. No se sube nada a ningún lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphiqo enregistre vos vidéos et photos terminées dans votre photothèque. Rien n’est envoyé en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphiqo salva i video e le foto completati nella tua libreria. Niente viene caricato da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphiqo は完成した動画や写真を写真ライブラリに保存します。どこにもアップロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphiqo는 완성된 비디오와 사진을 사진 보관함에 저장합니다. 어디에도 업로드되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Morphiqo salva seus vídeos e fotos finalizados na sua fototeca. Nada é enviado para lugar nenhum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拟颜会将处理好的视频和照片存储到你的照片图库，不会上传到任何地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拟颜会将处理好的视频和照片存储到你的照片图库，不会上传到任何地方。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Shown in the system alert the first time the app reads from Photos.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphiqo liest die Fotos und Videos, die du auswählst, um Gesichter auf diesem Gerät zu tauschen. Nichts verlässt dein Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphiqo reads the photos and videos you choose so it can swap faces on this device. Nothing leaves your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphiqo lee las fotos y los videos que elijas para intercambiar rostros en este dispositivo. Nada sale de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphiqo lit les photos et vidéos que vous choisissez afin d’échanger les visages sur cet appareil. Rien ne quitte votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphiqo legge le foto e i video che scegli per scambiare i volti su questo dispositivo. Niente lascia il tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphiqo は選択した写真や動画を読み込み、このデバイス上で顔を入れ替えます。データがデバイスの外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphiqo는 선택한 사진과 비디오를 읽어 이 기기에서 얼굴을 교체합니다. 어떤 데이터도 기기를 벗어나지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Morphiqo lê as fotos e os vídeos que você escolhe para trocar rostos neste dispositivo. Nada sai do seu dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拟颜会读取你选择的照片和视频，以便在本机完成换脸，所有内容都不会离开你的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拟颜会读取你选择的照片和视频，以便在本机完成换脸，所有内容都不会离开你的设备。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
