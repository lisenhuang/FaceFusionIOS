    "Morphiqo is not allowed to add to your photo library. You can turn that on in Settings, under Morphiqo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morphiqo darf nichts zu deiner Fotomediathek hinzufügen. Du kannst das in den Einstellungen unter Morphiqo aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morphiqo no tiene permiso para agregar elementos a tu fototeca. Puedes activarlo en Configuración, en la sección Morphiqo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morphiqo n’est pas autorisé à ajouter des éléments à votre photothèque. Vous pouvez l’autoriser dans Réglages, sous Morphiqo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morphiqo non ha il permesso di aggiungere elementi alla tua libreria foto. Puoi attivarlo in Impostazioni, alla voce Morphiqo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morphiqo は写真ライブラリへの追加を許可されていません。「設定」の Morphiqo でオンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morphiqo가 사진 보관함에 추가하도록 허용되어 있지 않습니다. 설정 앱의 Morphiqo에서 허용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Morphiqo não tem permissão para adicionar itens à sua fototeca. Você pode ativar isso em Ajustes, em Morphiqo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拟颜没有权限添加到你的照片图库。你可以在“设置”>“拟颜”中开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拟颜没有权限添加到你的照片图库。你可以在“设置”>“拟颜”中开启。"
          }
        }
      }
    },
