    "Lets the system spread the work across the Neural Engine, GPU and CPU. Fastest on most devices." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt das System die Arbeit auf Neural Engine, GPU und CPU verteilen. Auf den meisten Geräten am schnellsten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que el sistema reparta el trabajo entre el Neural Engine, la GPU y la CPU. Es lo más rápido en la mayoría de los dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse le système répartir le travail entre le Neural Engine, le GPU et le CPU. Le plus rapide sur la plupart des appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia che il sistema distribuisca il lavoro tra Neural Engine, GPU e CPU. È il più veloce sulla maggior parte dei dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neural Engine、GPU、CPU への処理の振り分けをシステムに任せます。ほとんどのデバイスで最速です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템이 뉴럴 엔진과 GPU, CPU에 작업을 나누어 맡깁니다. 대부분의 기기에서 가장 빠릅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa o sistema distribuir o trabalho entre o Neural Engine, a GPU e a CPU. Mais rápido na maioria dos dispositivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让系统在神经网络引擎、GPU 和 CPU 之间分配工作。在多数设备上最快。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让系统在神经网络引擎、GPU 和 CPU 之间分配工作。在多数设备上最快。"
          }
        }
      }
