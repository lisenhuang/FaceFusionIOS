    },
    "Applies straight away. The preview stays near‑black in both, so a swap is always judged against the same surround." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird sofort übernommen. Die Vorschau bleibt in beiden Fällen nahezu schwarz, damit ein Tausch immer vor demselben Umfeld beurteilt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica de inmediato. La vista previa se mantiene casi negra en ambos, así que un intercambio siempre se juzga sobre el mismo fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique immédiatement. L’aperçu reste quasi‑noir dans les deux cas, afin qu’un échange soit toujours jugé sur le même fond."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica subito. L'anteprima resta quasi‑nera in entrambi, così uno scambio si valuta sempre sullo stesso sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すぐに反映されます。プレビューの背景はどちらの外観でもほぼ黒のままなので、入れ替えた顔は常に同じ背景で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바로 적용됩니다. 미리보기 배경은 두 모드에서 모두 검은색에 가깝게 유지되므로, 바꾼 얼굴은 언제나 같은 주변 색을 기준으로 판단할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se imediatamente. A pré-visualização continua quase preta nas duas opções, então a troca é sempre avaliada sobre o mesmo fundo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即生效。两种外观下预览都保持近黑色，因此换脸效果始终在相同的背景下判断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即生效。两种外观下预览都保持近黑色，因此换脸效果始终在相同的背景下判断。"
          }
        }
      }
    },
