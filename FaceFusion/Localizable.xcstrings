    "Memory was running low, so detail enhancement and occlusion masking have been switched off. They return the next time the engine starts." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Speicher wurde knapp, deshalb wurden Detailverbesserung und Verdeckungsmaske abgeschaltet. Beim nächsten Start der Engine sind sie wieder aktiv."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quedaba poca memoria, así que se desactivaron la mejora de detalle y la máscara de oclusión. Volverán la próxima vez que se inicie el motor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mémoire venait à manquer : l’amélioration des détails et le masquage des occlusions ont été désactivés. Ils reviendront au prochain démarrage du moteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La memoria stava per esaurirsi, quindi il miglioramento del dettaglio e la maschera delle occlusioni sono stati disattivati. Torneranno al prossimo avvio del motore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリが不足したため、ディテールの強調と遮蔽マスクをオフにしました。次にエンジンを起動したときに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리가 부족하여 디테일 향상과 가림 마스크를 껐습니다. 엔진을 다시 시작하면 다시 켜집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A memória estava acabando, então o aprimoramento de detalhes e a máscara de oclusão foram desativados. Eles voltam na próxima vez que o motor iniciar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内存不足，已关闭细节增强和遮挡蒙版。下次引擎启动时会恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内存不足，已关闭细节增强和遮挡蒙版。下次引擎启动时会恢复。"
          }
        }
      }
    },
    "Missing someone? Tap their face in the preview to add them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlt jemand? Tippe in der Vorschau auf das Gesicht, um die Person hinzuzufügen."
