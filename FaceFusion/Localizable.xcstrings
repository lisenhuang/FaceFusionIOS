    "Keeps everything on the GPU and CPU. Worth trying if Automatic stutters." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält alles auf GPU und CPU. Einen Versuch wert, wenn „Automatisch“ stockt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene todo en la GPU y la CPU. Vale la pena probarlo si Automático se entrecorta."
