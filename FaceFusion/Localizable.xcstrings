    },
    "You have %@. The App Store did not answer, so there is nothing to compare it against — check your connection and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %@. Der App Store hat nicht geantwortet, es gibt also nichts zum Vergleichen — prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes la versión %@. El App Store no respondió, así que no hay con qué compararla — revisa tu conexión e inténtalo de nuevo."
