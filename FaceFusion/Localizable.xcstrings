    "Lower if someone is missed when they turn away; raise if the wrong person gets replaced." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedriger, wenn jemand beim Wegdrehen übersehen wird; höher, wenn die falsche Person ersetzt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja el valor si alguien queda sin detectar al voltearse; súbelo si se reemplaza a la persona equivocada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baissez si une personne est oubliée lorsqu’elle se détourne ; augmentez si la mauvaise personne est remplacée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbassalo se qualcuno non viene riconosciuto quando si gira; alzalo se viene sostituita la persona sbagliata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顔をそむけた人が検出されない場合は下げ、別の人が入れ替わってしまう場合は上げてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고개를 돌린 사람을 놓치면 낮추고, 엉뚱한 사람이 바뀌면 높이십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminua se alguém deixar de ser reconhecido ao virar o rosto; aumente se a pessoa errada for substituída."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人转头时被漏掉就调低，替换错了人就调高。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人转头时被漏掉就调低，替换错了人就调高。"
          }
        }
      }
    },
