        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più alto mantiene di più del volto di origine; più basso si avvicina all'originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高くするほどソースの顔の特徴が強く残り、低くするほど元の顔になじみます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "높일수록 소스 얼굴이 더 많이 남고, 낮출수록 원래 얼굴에 가깝게 섞입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
