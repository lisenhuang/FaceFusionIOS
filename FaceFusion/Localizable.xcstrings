    "Installed, but the engine could not load it. Everything works as though it were not there. Removing it and downloading it again usually fixes that." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みですが、エンジンが読み込めませんでした。存在しない場合と同じように動作します。削除してもう一度ダウンロードすると、たいていは解決します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치되어 있지만 엔진이 불러오지 못했습니다. 없는 것과 똑같이 동작합니다. 제거한 뒤 다시 다운로드하면 대개 해결됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装，但引擎无法加载。当前表现与未安装时相同。移除后重新下载通常可以解决。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安裝，但引擎無法載入。目前表現與未安裝時相同。移除後重新下載通常可以解決。"
          }
        }
      }
    },
    "Keep hands and hair" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手や髪を残す"
