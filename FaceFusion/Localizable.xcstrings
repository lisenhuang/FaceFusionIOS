    "Prefers the Neural Engine. Much slower for these models on some devices — measure before keeping it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevorzugt die Neural Engine. Für diese Modelle auf manchen Geräten deutlich langsamer — miss nach, bevor du dabei bleibst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefiere el Neural Engine. En algunos dispositivos es mucho más lento con estos modelos — mídelo antes de dejarlo así."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privilégie le Neural Engine. Bien plus lent pour ces modèles sur certains appareils — mesurez avant de le conserver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predilige il Neural Engine. Su alcuni dispositivi è molto più lento con questi modelli — misura prima di tenerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neural Engine を優先します。デバイスによっては、これらのモデルでは大幅に遅くなります。この設定のままにする前に計測してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뉴럴 엔진을 우선 사용합니다. 일부 기기에서는 이 모델들을 실행할 때 훨씬 느리므로, 계속 사용하기 전에 측정해 보십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioriza o Neural Engine. Bem mais lento para estes modelos em alguns dispositivos — meça antes de manter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先使用神经网络引擎。在部分设备上，这些模型会慢得多，请先测量再决定是否保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先使用神经网络引擎。在部分设备上，这些模型会慢得多，请先测量再决定是否保留。"
          }
        }
      }
    },
