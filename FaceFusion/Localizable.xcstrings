    "This frees %@. Swapping keeps working without it — the result is simply less refined." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das gibt %@ frei. Der Gesichtstausch funktioniert auch ohne — das Ergebnis ist einfach weniger fein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto libera %@. El intercambio sigue funcionando sin él — el resultado simplemente es menos refinado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela libère %@. L’échange continue de fonctionner sans lui — le résultat est simplement moins abouti."
          }
        },
        "it" : {
