        }
      }
    },
    "Keeps everything on the GPU and CPU. Worth trying if Automatic stutters." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての処理を GPU と CPU で行います。「自動」で引っかかりが出る場合に試す価値があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 작업을 GPU와 CPU에서 처리합니다. 자동 설정에서 끊김이 생긴다면 시도해 볼 만합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部交由 GPU 和 CPU 处理。如果“自动”出现卡顿，值得一试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部交由 GPU 和 CPU 处理。如果“自动”出现卡顿，值得一试。"
          }
        }
      }
    },
    "Keeps hands, hair and objects that cross the face from being painted over." : {
      "localizations" : {
