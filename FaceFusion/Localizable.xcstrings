    "Morphiqo needs permission to add to your photo library. You can grant it in Settings, or save to Files instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morphiqo braucht die Erlaubnis, etwas zu deiner Fotomediathek hinzuzufügen. Du kannst sie in den Einstellungen erteilen oder stattdessen in Dateien sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morphiqo necesita permiso para agregar elementos a tu fototeca. Puedes concederlo en Configuración o guardar en Archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morphiqo a besoin d’une autorisation pour ajouter des éléments à votre photothèque. Vous pouvez l’accorder dans Réglages, ou enregistrer dans Fichiers à la place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morphiqo ha bisogno del permesso per aggiungere elementi alla tua libreria foto. Puoi concederlo in Impostazioni, oppure salvare su File."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真ライブラリに追加するには Morphiqo の許可が必要です。「設定」で許可するか、「ファイル」に保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 보관함에 추가하려면 Morphiqo에 권한이 필요합니다. 설정에서 허용하거나 대신 파일에 저장할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Morphiqo precisa de permissão para adicionar itens à sua fototeca. Você pode concedê-la em Ajustes ou salvar em Arquivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拟颜需要获得授权才能添加到你的照片图库。你可以在“设置”中授权，或改为存储到“文件”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
