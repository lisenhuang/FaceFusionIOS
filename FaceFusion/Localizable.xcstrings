        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 공간을 확보합니다. 없어도 얼굴 교체는 계속되며, 결과가 조금 덜 정교해질 뿐입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会释放 %@。没有它也能换脸，只是效果会略微粗糙一些。"
