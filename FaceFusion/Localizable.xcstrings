    "Installed, but the engine could not load it. Everything works as though it were not there. Removing it and downloading it again usually fixes that." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiert, aber die Engine konnte es nicht laden. Alles funktioniert, als wäre es nicht vorhanden. Entfernen und erneut laden behebt das meistens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está instalado, pero el motor no pudo cargarlo. Todo funciona como si no estuviera. Eliminarlo y volver a descargarlo suele solucionarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installé, mais le moteur n’a pas pu le charger. Tout fonctionne comme s’il n’était pas là. Le supprimer puis le télécharger à nouveau résout généralement le problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installato, ma il motore non è riuscito a caricarlo. Tutto funziona come se non ci fosse. Di solito basta rimuoverlo e scaricarlo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みですが、エンジンが読み込めませんでした。存在しない場合と同じように動作します。削除してもう一度ダウンロードすると、たいていは解決します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치되어 있지만 엔진이 불러오지 못했습니다. 없는 것과 똑같이 동작합니다. 제거한 뒤 다시 다운로드하면 대개 해결됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalado, mas o motor não conseguiu carregá-lo. Tudo funciona como se ele não estivesse aí. Remover e baixar de novo costuma resolver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装，但引擎无法加载。当前表现与未安装时相同。移除后重新下载通常可以解决。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安裝，但引擎無法載入。目前表現與未安裝時相同。移除後重新下載通常可以解決。"
          }
        }
      }
    },
