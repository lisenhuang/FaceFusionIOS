        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai la versione %@. L'App Store non ha risposto, quindi non c'è nulla con cui confrontarla — controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
