    "Subscriptions renew automatically until cancelled. You can manage or cancel them in your App Store account settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abos verlängern sich automatisch, bis du kündigst. Du kannst sie in den Einstellungen deines App-Store-Accounts verwalten oder kündigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones se renuevan automáticamente hasta que las canceles. Puedes administrarlas o cancelarlas en la configuración de tu cuenta del App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements se renouvellent automatiquement jusqu’à leur annulation. Vous pouvez les gérer ou les annuler dans les réglages de votre compte App Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli abbonamenti si rinnovano automaticamente finché non li disdici. Puoi gestirli o disdirli nelle impostazioni del tuo account App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは解約するまで自動的に更新されます。App Store のアカウント設定で管理または解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독은 취소할 때까지 자동으로 갱신됩니다. App Store 계정 설정에서 관리하거나 취소할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas são renovadas automaticamente até serem canceladas. Você pode gerenciá-las ou cancelá-las nos ajustes da sua conta da App Store."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅会自动续期，直到你取消。你可以在 App Store 账户设置中管理或取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱會自動續期，直到你取消。你可以在 App Store 帳戶設定中管理或取消。"
          }
        }
      }
    },
