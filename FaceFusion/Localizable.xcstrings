    "Higher keeps more of the source face; lower blends toward the original." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höher behält mehr vom Quellgesicht; niedriger blendet zum Original über."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más alto conserva más del rostro de origen; más bajo se mezcla con el original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus haut conserve davantage du visage source ; plus bas se rapproche de l’original."
